# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.obj

# Virtual environments
.venv

# 凭据 / 环境变量（避免泄露账号密码）
.env
.env.*
# 例外：模板文件不含真实凭据，需随代码提交
!.env.example

# 抓包数据 / 逆向样本（含实时行情，可能敏感）
data/
captures_live/
*.pcap
*.pcapng
baratol*.log

# 扫码登录返回的设备凭据（含明文 account/password/imei）
tests/remember_*.json
tests/credentials*.json

# uv lock（可选，保留锁定依赖版本；如不需锁定可取消注释）
# uv.lock

# ZCode 会话计划/缓存（工具生成，不纳入版本控制）
.zcode/
