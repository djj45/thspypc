# thspypc 环境变量配置模板
#
# 用法：复制本文件为 .env（cp .env.example .env），填入真实账号密码。
# .env 已被 gitignore 忽略，不会提交（本模板不含任何真实凭据）。
#
# 读取逻辑：collect_push_samples.py / test_login.py 启动时自动加载项目根目录的
# .env 到 os.environ（已有环境变量不覆盖）。命令行 --user/--pwd 优先于 .env。
#
# ── 必填 ──
# 同花顺 PC 远航版账号密码（Level2 账号，8901 端口登录）
THS_USERNAME=
THS_PASSWORD=

# ── 可选 ──
# 设备 ID（32 字符十六进制）。留空则自动生成：MD5(第一个网卡MAC大写连字符 + "0"*30)
# 同一设备每次生成都相同（绑定网卡 MAC），无需手动填。仅在需要固定设备指纹时填写。
# 算法见 protocol.py 的 generate_imei()。
THS_IMEI=
